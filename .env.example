# Shared local configuration reference. Copy values into an ignored .env file
# or configure them through the deployment environment. Never commit secrets.

APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost
API_BASE_URL=http://localhost
API_DEFAULT_PER_PAGE=20
API_MAX_PER_PAGE=100

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sim_recipes
DB_USERNAME=sim_recipes
DB_PASSWORD=change-me-locally

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
