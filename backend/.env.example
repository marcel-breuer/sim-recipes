# Laravel API local configuration reference. Never commit a populated .env file.

APP_NAME=SimRecipes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
API_DEFAULT_PER_PAGE=20
API_MAX_PER_PAGE=100
API_AUTH_TOKEN_EXPIRATION_DAYS=30

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sim_recipes
DB_USERNAME=sim_recipes
DB_PASSWORD=change-me-locally

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
