{
  "openapi": "3.1.0",
  "info": {
    "title": "SimRecipes API",
    "version": "v1",
    "description": "The versioned public application contract for SimRecipes."
  },
  "servers": [
    { "url": "/api/v1" }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": { "$ref": "#/components/responses/HealthResponse" }
        }
      }
    },
    "/auth/apple": {
      "post": {
        "operationId": "signInWithApple",
        "requestBody": { "$ref": "#/components/requestBodies/AppleLogin" },
        "responses": {
          "200": { "$ref": "#/components/responses/AuthSessionResponse" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/cameras": {
      "get": {
        "operationId": "listCameras",
        "responses": {
          "200": { "$ref": "#/components/responses/CameraCollection" }
        }
      }
    },
    "/cameras/{camera}": {
      "get": {
        "operationId": "getCamera",
        "parameters": [{ "$ref": "#/components/parameters/Camera" }],
        "responses": {
          "200": { "$ref": "#/components/responses/CameraResponse" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/cameras/{camera}/capabilities": {
      "get": {
        "operationId": "listCameraCapabilities",
        "parameters": [{ "$ref": "#/components/parameters/Camera" }],
        "responses": {
          "200": { "$ref": "#/components/responses/CameraCapabilityCollection" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/categories": {
      "get": {
        "operationId": "listCategories",
        "responses": {
          "200": { "$ref": "#/components/responses/CategoryCollection" }
        }
      }
    },
    "/recipes": {
      "get": {
        "operationId": "listRecipes",
        "parameters": [
          { "$ref": "#/components/parameters/Feed" },
          { "$ref": "#/components/parameters/Search" },
          { "$ref": "#/components/parameters/CompatibilityEvidence" },
          { "$ref": "#/components/parameters/PerPage" },
          { "$ref": "#/components/parameters/Page" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/RecipePage" }
        }
      },
      "post": {
        "operationId": "createRecipe",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/CreateRecipe" },
        "responses": {
          "201": { "$ref": "#/components/responses/RecipeResponse" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/recipes/{recipe}": {
      "get": {
        "operationId": "getRecipe",
        "parameters": [{ "$ref": "#/components/parameters/Recipe" }],
        "responses": {
          "200": { "$ref": "#/components/responses/RecipeResponse" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/recipes/{recipe}/view": {
      "post": {
        "operationId": "recordRecipeView",
        "parameters": [{ "$ref": "#/components/parameters/Recipe" }],
        "responses": {
          "204": { "description": "The view was recorded or deduplicated." },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "parameters": {
      "Camera": { "name": "camera", "in": "path", "required": true, "schema": { "type": "string" } },
      "Recipe": { "name": "recipe", "in": "path", "required": true, "schema": { "type": "string" } },
      "Feed": { "name": "feed", "in": "query", "schema": { "type": "string", "enum": ["popular", "newest"] } },
      "Search": { "name": "search", "in": "query", "schema": { "type": "string" } },
      "CompatibilityEvidence": { "name": "compatibility_evidence", "in": "query", "description": "Minimum evidence for every recipe setting; requires camera_model_id.", "schema": { "type": "string", "enum": ["manufacturer_documented", "camera_verified"] } },
      "PerPage": { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } }
    },
    "requestBodies": {
      "AppleLogin": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["identity_token"],
              "properties": { "identity_token": { "type": "string" }, "authorization_code": { "type": "string" } }
            }
          }
        }
      },
      "CreateRecipe": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": { "$ref": "#/components/schemas/CreateRecipe" }
          }
        }
      }
    },
    "responses": {
      "HealthResponse": { "description": "API health", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthEnvelope" } } } },
      "AuthSessionResponse": { "description": "Authenticated session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataEnvelope" } } } },
      "CameraCollection": { "description": "Camera models", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataArrayEnvelope" } } } },
      "CameraResponse": { "description": "Camera model", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataEnvelope" } } } },
      "CameraCapabilityCollection": { "description": "Camera capabilities", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CameraCapabilityArrayEnvelope" } } } },
      "CategoryCollection": { "description": "Recipe categories", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataArrayEnvelope" } } } },
      "RecipeResponse": { "description": "Recipe", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataEnvelope" } } } },
      "RecipePage": { "description": "Paginated recipes", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageEnvelope" } } } },
      "Unauthenticated": { "description": "Authentication is required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "ValidationError": { "description": "Validation failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "NotFound": { "description": "Resource not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
    },
    "schemas": {
      "DataEnvelope": { "type": "object", "required": ["data"], "properties": { "data": {} } },
      "DataArrayEnvelope": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array" } } },
      "CameraCapabilityArrayEnvelope": { "type": "object", "required": ["data"], "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/CameraCapability" } } } },
      "CameraCapability": { "type": "object", "required": ["id", "key", "display_name", "value_type", "evidence"], "properties": { "id": { "type": "string" }, "key": { "type": "string" }, "display_name": { "type": "string" }, "value_type": { "type": "string" }, "allowed_values": {}, "minimum": { "type": ["number", "null"] }, "maximum": { "type": ["number", "null"] }, "step": { "type": ["number", "null"] }, "transport_identifier": { "type": ["string", "null"] }, "custom_slot_metadata": { "type": ["object", "null"] }, "evidence": { "$ref": "#/components/schemas/CameraCapabilityEvidence" } } },
      "CameraCapabilityEvidence": { "type": "object", "required": ["level", "source", "firmware", "verified_at"], "properties": { "level": { "type": "string", "enum": ["catalog_only", "manufacturer_documented", "camera_verified"] }, "source": { "type": ["string", "null"] }, "firmware": { "type": ["string", "null"] }, "verified_at": { "type": ["string", "null"], "format": "date-time" } } },
      "CreateRecipe": { "type": "object", "required": ["name", "camera_model_id"], "properties": { "name": { "type": "string", "maxLength": 120 }, "camera_model_id": { "type": "string" }, "images": { "type": "array", "maxItems": 5, "items": { "type": "string", "format": "binary" } }, "capture_metadata": { "type": "string", "contentMediaType": "application/json", "description": "JSON array aligned by index with images; each item is null or RecipeCaptureMetadata." } } },
      "RecipeCaptureMetadata": { "type": "object", "required": ["source", "location_shared"], "properties": { "source": { "type": "string", "enum": ["fujifilm_jpeg", "jpeg_exif"] }, "camera_make": { "type": ["string", "null"] }, "camera_model": { "type": ["string", "null"] }, "lens_model": { "type": ["string", "null"] }, "exposure": { "type": ["object", "null"], "properties": { "iso": { "type": ["number", "null"] }, "exposure_time_seconds": { "type": ["number", "null"] }, "f_number": { "type": ["number", "null"] }, "focal_length_mm": { "type": ["number", "null"] }, "exposure_compensation_ev": { "type": ["number", "null"] } } }, "settings": { "type": "array", "items": { "type": "object", "required": ["setting_key", "value", "source", "was_edited"], "properties": { "setting_key": { "type": "string" }, "value": {}, "source": { "type": "string" }, "was_edited": { "type": "boolean" } } } }, "scene_notes": { "type": ["string", "null"], "maxLength": 500 }, "lighting_notes": { "type": ["string", "null"], "maxLength": 500 }, "location": { "type": ["object", "null"], "properties": { "latitude": { "type": "number", "minimum": -90, "maximum": 90 }, "longitude": { "type": "number", "minimum": -180, "maximum": 180 } } }, "location_shared": { "type": "boolean", "default": false } } },
      "RecipeImage": { "type": "object", "properties": { "id": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "capture_metadata": { "oneOf": [{ "$ref": "#/components/schemas/RecipeCaptureMetadata" }, { "type": "null" }], "description": "Location is included only when location_shared is true." } } },
      "HealthEnvelope": { "type": "object", "required": ["data"], "properties": { "data": { "$ref": "#/components/schemas/Health" } } },
      "Health": { "type": "object", "required": ["service", "status", "version"], "properties": { "service": { "type": "string" }, "status": { "type": "string" }, "version": { "type": "string" } } },
      "PageEnvelope": { "type": "object", "required": ["data", "links", "meta"], "properties": { "data": { "type": "array" }, "links": { "type": "object" }, "meta": { "$ref": "#/components/schemas/PageMeta" } } },
      "PageMeta": { "type": "object", "required": ["current_page", "last_page", "per_page", "total"], "properties": { "current_page": { "type": "integer" }, "last_page": { "type": "integer" }, "per_page": { "type": "integer" }, "total": { "type": "integer" } } },
      "ErrorEnvelope": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": { "type": "object" } } } } }
    }
  }
}
