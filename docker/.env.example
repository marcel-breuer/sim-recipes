# Copy this file to .env before running Compose locally.
# Coolify can import these same variables as application secrets/variables.

APP_NAME=SimRecipes
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:replace-with-a-32-byte-laravel-key
APP_URL=https://api.example.com
API_PORT=8000

DB_DATABASE=sim_recipes
DB_USERNAME=sim_recipes
DB_PASSWORD=replace-with-a-long-random-password

REDIS_PASSWORD=replace-with-a-long-random-password

# Use s3 for Coolify/production. For a disposable local stack, use local.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Required for live Sign in with Apple. Leave empty for health-only testing.
APPLE_CLIENT_ID=

# Seed the X-S20 camera/capability catalog on the first deployment only.
AUTORUN_LARAVEL_MIGRATION_SEED=false

# Optional image/runtime overrides.
API_IMAGE=sim-recipes-api
API_IMAGE_TAG=local
PHP_OPCACHE_ENABLE=1
PHP_UPLOAD_MAX_FILE_SIZE=25M
PHP_POST_MAX_SIZE=30M
NGINX_CLIENT_MAX_BODY_SIZE=30M
