# Laravel API local configuration reference. Never commit a populated .env file.

APP_NAME=SimRecipes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
API_DEFAULT_PER_PAGE=20
API_MAX_PER_PAGE=100

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sim_recipes
DB_USERNAME=sim_recipes
DB_PASSWORD=change-me-locally

BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
